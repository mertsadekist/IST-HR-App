# ============================================================================
# IST HR System — environment configuration TEMPLATE
# Copy to .env and fill with real values. NEVER commit the real .env.
# Rotate any secret that has ever been committed to source control.
# ============================================================================

# Database (use a least-privilege user; keep the DB off the public internet)
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=change-me
DB_NAME=ist_hr

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-long-random
JWT_EXPIRES_IN=24h

# Encryption key for stored credentials (REQUIRED, distinct from JWT_SECRET)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-me-64-hex-chars

# DeepSeek AI
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Server
PORT=3001
NODE_ENV=development
# Production CORS origin (exact URL) — required when NODE_ENV=production
CLIENT_URL=https://your-frontend.example.com

# File storage — MUST be a mounted persistent volume in production so uploaded
# files / official documents survive container rebuilds & redeploys.
UPLOADS_DIR=/data/uploads
# Path to the built React client served by Express in production (set in Docker)
CLIENT_DIST=/app/client/dist

# Initial admin password for setup-db.js (optional; a random one is generated if unset)
ADMIN_INITIAL_PASSWORD=

# Dev-only escape hatch to skip outbound TLS verification (DeepSeek/SMTP).
# Has NO effect when NODE_ENV=production. Leave unset/false unless debugging.
ALLOW_INSECURE_TLS=false

# ─── Attendance sync from Hik Central (PostgreSQL, read-only) ────────────────
# Door punches are read live from the Hik Central database. First punch of the
# day = check-in, last punch = check-out. See docs/attendance_hik_sync.md.
#
# ALL of these are RUNTIME variables in Coolify — never build-time (build args are
# written into image layers and the build log). Never commit real values.
#
# 1) The connection. Create a SELECT-only role on the Hik side for this — the
#    sync also opens every query READ ONLY, but a least-privilege user is the
#    first lock.
HIK_DB_HOST=
HIK_DB_PORT=5432
HIK_DB_USER=
HIK_DB_PASSWORD=
HIK_DB_NAME=
# require (default in production): encrypted, certificate not checked.
# verify: encrypted AND certificate checked — set HIK_DB_SSL_CA to the base64 of
#         the server's CA certificate if it is not a public one.
# disable: plain text over the network. Only for a private network / SSH tunnel.
HIK_DB_SSL=require
HIK_DB_SSL_CA=

# 2) Where the door events are. Run `node check_hik_sync.mjs --discover` (or the
#    Schema button on Attendance → Hik Central Sync) to list the tables and
#    columns, then fill these in. A VIEW works as well as a table — if the person
#    id lives in a different table from the events, create a view that joins them.
HIK_EVENTS_TABLE=public.attendance_events
# The person's number as the fingerprint/face device knows it. It is matched to
# the "Attendance ID" on the employee record.
HIK_COL_PERSON_ID=person_id
# Optional — only used to name people who are in Hik but not in the HR system.
HIK_COL_PERSON_NAME=
HIK_COL_EVENT_TIME=event_time
# How the time column is stored: timestamptz | timestamp_local | timestamp_utc |
# epoch_s | epoch_ms
HIK_EVENT_TIME_TYPE=timestamptz
# Optional filters, if the table also holds events that are not door entries.
# Values are matched as text and comma-separated. Leave empty to take every row.
HIK_COL_EVENT_TYPE=
HIK_EVENT_TYPE_VALUES=
HIK_COL_DEVICE=
HIK_DEVICE_VALUES=

# 3) Behaviour (all optional — these are the defaults).
# The office time zone the punches are read in (also decides what "today" is).
# Defaults to the app timezone.
HIK_EVENT_TZ=
# How often the live pass recomputes today, and how many days back it re-reads
# (so a late-arriving punch still lands on the right day).
HIK_SYNC_INTERVAL_MINUTES=5
HIK_SYNC_LOOKBACK_DAYS=2
# The daily close (absences, leave, schedule checks, the email), local time.
HIK_FINALIZE_HOUR=5
HIK_FINALIZE_MINUTE=0
# A second tap this soon after the first is a double-tap, not a departure.
HIK_MIN_STAY_MINUTES=30
# The automatic passes never touch days before this. Defaults to the day the
# sync first runs. Use the Backfill button to load older days on purpose.
HIK_SYNC_START_DATE=
# Safety limits.
HIK_STATEMENT_TIMEOUT_MS=20000
HIK_MAX_EVENTS=200000
