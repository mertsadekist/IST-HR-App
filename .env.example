# ============================================================================
# IST HR System — environment configuration TEMPLATE
# Copy to .env and fill with real values. NEVER commit the real .env.
# Rotate any secret that has ever been committed to source control.
# ============================================================================

# Database (use a least-privilege user; keep the DB off the public internet)
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=change-me
DB_NAME=ist_hr

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-long-random
JWT_EXPIRES_IN=24h

# Encryption key for stored credentials (REQUIRED, distinct from JWT_SECRET)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-me-64-hex-chars

# DeepSeek AI
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Server
PORT=3001
NODE_ENV=development
# Production CORS origin (exact URL) — required when NODE_ENV=production
CLIENT_URL=https://your-frontend.example.com

# File storage — MUST be a mounted persistent volume in production so uploaded
# files / official documents survive container rebuilds & redeploys.
UPLOADS_DIR=/data/uploads
# Path to the built React client served by Express in production (set in Docker)
CLIENT_DIST=/app/client/dist

# Initial admin password for setup-db.js (optional; a random one is generated if unset)
ADMIN_INITIAL_PASSWORD=

# Dev-only escape hatch to skip outbound TLS verification (DeepSeek/SMTP).
# Has NO effect when NODE_ENV=production. Leave unset/false unless debugging.
ALLOW_INSECURE_TLS=false

# ─── Attendance sync from Google Drive ───────────────────────────────────────
# Read-only service account scoped to one shared folder. See
# docs/attendance_drive_sync_plan.md §9a for how to create these.
# Runtime-only in Coolify — never commit real values.
# Paste the WHOLE service-account JSON file here, base64-encoded. Base64 carries
# no quotes, braces or newlines, so nothing downstream can mangle it — a raw JSON
# blob breaks Dockerfile ARG parsing outright. The email is read from inside it.
#   Linux/macOS:  base64 -w0 key.json
#   PowerShell:   [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
#
# MUST be a RUNTIME variable, never a build-time one: build arguments are
# written into the image layers and printed in the build log.
GOOGLE_DRIVE_SA_JSON=
# Optional — only to override the email inside the JSON, or if the key is
# supplied as a bare PEM instead.
GOOGLE_DRIVE_SA_EMAIL=
ATTENDANCE_DRIVE_FOLDER_ID=the-id-from-the-drive-folder-url
# The sync ignores files dated before this. Defaults to the first run's date.
ATTENDANCE_SYNC_START_DATE=
